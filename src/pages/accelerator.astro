---
import "@fontsource/inter/variable.css";
import Footer from "~/components/footer.astro";
import Header from "~/components/header.astro";
import "~/styles/index.css";

const { site } = Astro;
const description = "ML@Purdue Accelerator Program";

const applyUrl = "https://mlpurdue.clubrecruiter.app/q/avc3uxn";

const timelineItems = [
  {
    phase: "Phase 1",
    title: "Theory",
    description:
      "Work with your mentor and mentee group to understand the ML behind your project.",
  },
  {
    phase: "Phase 2",
    title: "Application",
    description:
      "Apply that theory to build something that solves a real world issue.",
  },
  {
    phase: "Finale",
    title: "Symposium",
    description: "Present your project at the ML@Purdue Final Symposium.",
  },
];
---

<!DOCTYPE html>
<html lang="en" class="h-full motion-safe:scroll-smooth" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>ML@Purdue - Accelerator Program</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="ML@Purdue Accelerator" />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/social.png" />
    <meta property="og:url" content={site} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body
    class="h-full overflow-x-hidden bg-default text-default text-base selection:bg-secondary selection:text-white"
  >
    <Header fixed />

    <!-- Hero: heading + intro + primary Apply CTA -->
    <section class="w-full bg-black pt-28 pb-20 text-white">
      <div class="mx-auto w-[90vw] max-w-6xl">
        <h2 class="orbitron font-bold text-6xl sm:text-8xl">Accelerator</h2>
        <p class="mt-6 max-w-2xl opacity-90 text-base sm:text-lg">
          ML@Purdue's program for those with
          <span class="font-bold">beginner to intermediate ML skills</span>. As
          a mentee, you'll be paired with a mentor in a group of 2&ndash;4 other
          mentees to first understand the ML behind your project, then apply
          that theory to solve a real world issue. The program lasts one
          semester and asks for about 4 hours per week.
        </p>

        <div class="mt-10 flex flex-col items-start gap-3">
          <a
            href={applyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 bg-white px-8 py-4 font-semibold text-black text-lg transition-colors hover:!text-[#A45DF5]"
          >
            Apply to Accelerator
          </a>
          <p class="opacity-70 text-sm">
            Applications are open now &mdash; we highly recommend freshmen
            apply!
          </p>
        </div>
      </div>
    </section>

    <!-- Program Structure: one-semester timeline -->
    <section class="w-full bg-white py-20 text-black">
      <div class="mx-auto w-[90vw] max-w-6xl">
        <h2 class="font-bold text-4xl sm:text-6xl">Program Structure</h2>
        <p class="mt-6 max-w-2xl opacity-80 text-xl sm:text-2xl">
          One semester, ~4 hours per week, in a small group of 2&ndash;4 mentees
          led by your mentor.
        </p>

        <div class="mt-10 grid gap-6 sm:grid-cols-3">
          {
            timelineItems.map((item) => (
              <div class="flex flex-col bg-black p-6 text-white">
                <span class="self-start bg-[#A45DF5] px-3 py-1 font-semibold text-sm">
                  {item.phase}
                </span>
                <h3 class="mt-5 font-bold text-3xl">{item.title}</h3>
                <p class="mt-3 opacity-90 text-lg">{item.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Who is Accelerator for? -->
    <section class="w-full bg-[#A45DF5] py-20 text-white">
      <div class="mx-auto w-[90vw] max-w-6xl">
        <h2 class="font-bold text-4xl sm:text-6xl">Who is Accelerator for?</h2>

        <p class="mt-8 max-w-4xl opacity-90 text-lg sm:text-xl">
          Accelerator is built for students with beginner to intermediate ML
          skills, and we highly recommend freshmen apply! Accelerator alumni
          often join a
          <a
            href="/projects"
            class="font-semibold underline decoration-2 underline-offset-4 hover:!text-white hover:opacity-70"
            >Project Team</a
          >
          or step up as a director or committee member on our
          <a
            href="/board"
            class="font-semibold underline decoration-2 underline-offset-4 hover:!text-white hover:opacity-70"
            >Board</a
          >
          in subsequent semesters!
        </p>

        <p class="mt-6 max-w-4xl opacity-90 text-lg sm:text-xl">
          Accelerator isn't the only way in. Our
          <a
            href="/reading-group"
            class="font-semibold underline decoration-2 underline-offset-4 hover:!text-white hover:opacity-70"
            >Reading Group</a
          >
          and
          <a
            href="/workshops"
            class="font-semibold underline decoration-2 underline-offset-4 hover:!text-white hover:opacity-70"
            >Workshops</a
          >
          are open to everyone and are a great way to get hands-on with ML alongside
          the program.
        </p>
      </div>
    </section>

    <Footer />
  </body>
</html>
